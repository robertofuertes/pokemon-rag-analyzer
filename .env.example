MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=pokemon_rag
POKEMON_JSON_PATH=./pokemon_gen1.json

# Scraper: polite delay (seconds) between Pokemon detail-page requests.
# The initial Pokedex list request is never delayed.
SCRAPER_REQUEST_DELAY_SECONDS=0.5
# Scraper: HTTP request timeout (seconds).
SCRAPER_TIMEOUT_SECONDS=30
# Scraper: retry/backoff settings for transient failures (timeouts,
# connection errors, 429, and 5xx responses).
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=0.5

# Vector index (ChromaDB): local persistence directory and collection name.
VECTOR_INDEX_PERSIST_DIRECTORY=./chroma_data
VECTOR_INDEX_COLLECTION_NAME=pokemon_gen1_tactics
# Number of dimensions used by the deterministic hashing embedding function.
VECTOR_INDEX_EMBEDDING_DIMENSIONS=256
